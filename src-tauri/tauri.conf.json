{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShellTree",
  "version": "0.1.0",
  "identifier": "com.shelltree.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ShellTree",
        "width": 1320,
        "height": 820,
        "minWidth": 800,
        "minHeight": 500,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true,
        "backgroundColor": "#17191e",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM3NjBCRTMyMjEwRjc1MDMKUldRRGRROGhNcjVnTnhNMXFKMCtnNUtSQy9VT3ovOXJHSjVWQnh2WDQzNHJJK3Rha2luNU05NFAK",
      "endpoints": [
        "https://github.com/ADroidCoder/ShellTree/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
